{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Instagram Desktop",
  "version": "1.0.8",
  "identifier": "com.instagram.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Instagram",
        "label": "main",
        "width": 1180,
        "height": 840,
        "minWidth": 400,
        "minHeight": 500,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Official Instagram Web Desktop Client with Native Windows & Linux Notifications",
    "longDescription": "A sleek, native desktop client for Instagram featuring full Windows & Linux toast notifications, unread badges, system tray integration, and custom toolbar.",
    "copyright": "Copyright © 2026",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "libgtk-3-0",
          "libssl3"
        ],
        "section": "net"
      },
      "appimage": {
        "bundleMediaFramework": true
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "libayatana-appindicator3",
          "gtk3",
          "openssl"
        ]
      }
    }
  }
}
